    "react-dom": "^19.3.1",
    "suncalc": "^2.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  },
  "browserslist": [
