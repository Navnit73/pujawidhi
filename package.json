{
  "name": "pujawidhi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "seed": "tsx scripts/seed-content.ts",
    "check:content": "tsx scripts/check-content.ts",
    "build:index": "tsx scripts/build-index.ts",
    "predev": "tsx scripts/build-index.ts && tsx scripts/build-static-assets.tsx",
    "dev": "next dev",
